# ── Links — environment variables ──────────────────────────────
# Copy to .env for local dev, or set these in Vercel → Project → Settings → Environment Variables.

# Turso database (https://turso.tech — free tier)
# Create a database, then run the provided Colab notebook (turso-setup.ipynb)
# to push the schema, and paste the values here.
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret used to sign session cookies — generate one:
#   bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
AUTH_SECRET=paste-a-long-random-string-here

# Resend (https://resend.com — free tier, 100 emails/day)
# Verify the namansoni.in domain in Resend first (SPF + DKIM records),
# so mail can be sent from no-reply@links.namansoni.in to anyone.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Links <no-reply@links.namansoni.in>

# Admin panel credentials for https://links.namansoni.in/admin
ADMIN_USERNAME=choose-a-username
ADMIN_PASSWORD=choose-a-strong-password

# The public URL of the deployed site
NEXT_PUBLIC_SITE_URL=https://links.namansoni.in
